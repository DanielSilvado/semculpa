{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/venda",
      "has": [{ "type": "host", "value": "aula-mapa-do-posicionamento.vercel.app" }],
      "destination": "https://imersao-sem-culpa.vercel.app/",
      "permanent": false
    },
    {
      "source": "/venda/(.*)",
      "has": [{ "type": "host", "value": "aula-mapa-do-posicionamento.vercel.app" }],
      "destination": "https://imersao-sem-culpa.vercel.app/",
      "permanent": false
    },
    {
      "source": "/aula",
      "has": [{ "type": "host", "value": "imersao-sem-culpa.vercel.app" }],
      "destination": "https://aula-mapa-do-posicionamento.vercel.app/",
      "permanent": false
    },
    {
      "source": "/aula/(.*)",
      "has": [{ "type": "host", "value": "imersao-sem-culpa.vercel.app" }],
      "destination": "https://aula-mapa-do-posicionamento.vercel.app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "imersao-sem-culpa.vercel.app" }],
      "destination": "/venda/index.html"
    },
    {
      "source": "/",
      "destination": "/aula/index.html"
    }
  ]
}
